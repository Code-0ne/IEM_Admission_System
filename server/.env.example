# Server configuration — copy to .env and fill in. NEVER commit .env.

# App
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Supabase (PostgreSQL)
SUPABASE_URL=urlkey
SUPABASE_ANON_KEY=anon
SUPABASE_SERVICE_ROLE_KEY=servicerole
DATABASE_URL=databaseurl

# MongoDB (GridFS only)
MONGODB_URI=mongodb://localhost:27017/iem_admission_files

# Session & Auth
SESSION_SECRET=secret
SESSION_MAX_AGE_MS=7200000
TOKEN_SECRET=your-token-secret-change-in-production

# Admin account provisioning (run npm run seed:admin from server/)
ADMIN_SEED_EMAIL=admin@iem.edu.in
ADMIN_SEED_PASSWORD=replace-with-a-unique-strong-password
ADMIN_SEED_NAME=IEM Admission Admin
ADMIN_SEED_MOBILE=9876500000

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@iem.edu.in
SMTP_PASS=your-password

# Payment Gateway (Mock or hosted)
PAYMENT_GATEWAY_KEY=your-payment-key
PAYMENT_GATEWAY_SECRET=your-payment-secret

# LLM Provider
LLM_API_KEY=your-llm-api-key
LLM_API_URL=http://localhost:11434/v1
