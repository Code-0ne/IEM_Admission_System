# Server configuration — copy to .env and fill in. NEVER commit .env.

# MongoDB Atlas connection string (SRV). Get this from Atlas > Database > Connect > Drivers.
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/iem_admission_dev?retryWrites=true&w=majority&appName=iem-admission
MONGODB_URI=

# Port the Express API listens on (the Vite dev proxy targets this)
PORT=5000

# Only origin allowed by CORS (the React dev server)
CLIENT_ORIGIN=http://localhost:5173

# HMAC/pepper secret used when hashing session tokens and OTPs before storage.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=change-me-in-.env

# Environment: development | test | production
NODE_ENV=development
